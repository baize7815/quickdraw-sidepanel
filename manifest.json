{
  "manifest_version": 3,
  "name": "Quickdraw 侧边栏画板",
  "version": "3.8.7",
  "minimum_chrome_version": "116",
  "description": "本地侧边栏无限画布。支持可编辑 Mermaid 多图表导入、AI 图表生成、钢笔矢量路径、透明像素裁剪、图片处理及多格式导出。",
  "permissions": [
    "sidePanel",
    "storage",
    "unlimitedStorage",
    "contextMenus",
    "downloads",
    "activeTab",
    "clipboardWrite",
    "scripting",
    "tabGroups",
    "alarms"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "host_permissions": [
    "https://www.koukoutu.com/*",
    "https://*.koukoutu.com/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'",
    "sandbox": "sandbox allow-scripts; script-src 'self' 'unsafe-eval' 'wasm-unsafe-eval'; object-src 'none'"
  },
  "sandbox": {
    "pages": [
      "opencv-sandbox.html"
    ]
  },
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "打开 Quickdraw 侧边栏画板"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
