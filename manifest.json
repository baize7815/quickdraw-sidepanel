{
  "manifest_version": 3,
  "name": "Quickdraw 侧边栏画板",
  "version": "3.7.5",
  "minimum_chrome_version": "116",
  "description": "本地侧边栏无限画布。支持钢笔矢量路径、透明轮廓转 SVG、旋转与镜像、图片遮罩、宫格切图、比例裁剪、AI 抠图及多格式导出。",
  "permissions": [
    "sidePanel",
    "storage",
    "unlimitedStorage",
    "contextMenus",
    "downloads",
    "activeTab",
    "clipboardWrite",
    "scripting",
    "tabGroups"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "host_permissions": [
    "https://www.koukoutu.com/*",
    "https://*.koukoutu.com/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'",
    "sandbox": "sandbox allow-scripts; script-src 'self' 'unsafe-eval' 'wasm-unsafe-eval'; object-src 'none'"
  },
  "sandbox": {
    "pages": ["opencv-sandbox.html"]
  },
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "打开 Quickdraw 侧边栏画板"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
